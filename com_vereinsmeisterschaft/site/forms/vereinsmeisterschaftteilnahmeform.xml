    <field name="teilnehmer" required="true" label="COM_VEREINSMEISTERSCHAFT_FORM_LBL_VEREINSMEISTERSCHAFTTEILNAHME_TEILNEHMER" description="COM_VEREINSMEISTERSCHAFT_FORM_DESC_VEREINSMEISTERSCHAFTTEILNAHME_TEILNEHMER" hint="COM_VEREINSMEISTERSCHAFT_FORM_LBL_VEREINSMEISTERSCHAFTTEILNAHME_TEILNEHMER"/>
    <field name="zusage" type="list" required="true" label="COM_VEREINSMEISTERSCHAFT_FORM_LBL_VEREINSMEISTERSCHAFTTEILNAHME_ZUSAGE" description="COM_VEREINSMEISTERSCHAFT_FORM_DESC_VEREINSMEISTERSCHAFTTEILNAHME_ZUSAGE" hint="COM_VEREINSMEISTERSCHAFT_FORM_LBL_VEREINSMEISTERSCHAFTTEILNAHME_ZUSAGE">
