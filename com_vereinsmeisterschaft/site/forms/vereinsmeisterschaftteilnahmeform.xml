    <field name="mitbringsel" cols="1" rows="2" filter="safehtml" type="textarea" label="COM_VEREINSMEISTERSCHAFT_FORM_LBL_VEREINSMEISTERSCHAFTTEILNAHME_MITBRINGSEL" description="COM_VEREINSMEISTERSCHAFT_FORM_DESC_VEREINSMEISTERSCHAFTTEILNAHME_MITBRINGSEL" hint="COM_VEREINSMEISTERSCHAFT_FORM_LBL_VEREINSMEISTERSCHAFTTEILNAHME_MITBRINGSEL"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
